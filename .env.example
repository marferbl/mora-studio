# Contact form (src/app/contacto). Emails are sent through Resend: https://resend.com
RESEND_API_KEY=
# Inbox that receives the enquiries
CONTACT_TO_EMAIL=
# Verified sender in Resend, e.g. "Mora Studio <hola@tudominio.com>".
# Defaults to Resend's test sender, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=
